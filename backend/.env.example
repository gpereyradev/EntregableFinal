APP_NAME="Nova Salud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DEMO=true
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@localhost:5432/nova_salud
DB_SSLMODE=prefer
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
LOG_CHANNEL=stderr
DEMO_ADMIN_PASSWORD=
DEMO_SELLER_PASSWORD=
